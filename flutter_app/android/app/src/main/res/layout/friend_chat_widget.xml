<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="horizontal"
    android:gravity="center_vertical"
    android:padding="12dp"
    android:background="@drawable/friend_widget_background">

    <!-- Left side: User profile picture / avatar (Enlarged to 60x60, taking ~65% of widget height) -->
    <FrameLayout
        android:layout_width="60dp"
        android:layout_height="60dp"
        android:background="#F0F2F5">
        <ImageView
            android:id="@+id/widget_photo"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:scaleType="centerCrop"
            android:visibility="gone"
            android:importantForAccessibility="no" />
        <TextView
            android:id="@+id/widget_initial"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="center"
            android:text="+"
            android:textColor="#2563EB"
            android:textSize="24sp"
            android:textStyle="bold"
            android:importantForAccessibility="no" />
    </FrameLayout>

    <!-- RemoteViews-safe spacer view -->
    <View
        android:layout_width="14dp"
        android:layout_height="1dp" />

    <!-- Right side: User full name & status hint -->
    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical"
        android:gravity="center_vertical">
        <TextView
            android:id="@+id/widget_name"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="start|center_vertical"
            android:maxLines="2"
            android:ellipsize="end"
            android:includeFontPadding="false"
            android:text="@string/friend_widget_choose"
            android:textColor="#18212F"
            android:textSize="15sp"
            android:textStyle="bold" />
        <TextView
            android:id="@+id/widget_hint"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="3dp"
            android:gravity="start|center_vertical"
            android:maxLines="1"
            android:ellipsize="end"
            android:text="@string/friend_widget_setup"
            android:textColor="#687386"
            android:textSize="12sp" />
    </LinearLayout>
</LinearLayout>
